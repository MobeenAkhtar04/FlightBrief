# Copy this file to .env and fill in real values before deploying.
# .env is gitignored — never commit it.

# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-this-with-a-real-random-secret

# Database credentials — change the password to something strong
DB_USER=flightbrief
DB_PASSWORD=replace-this-with-a-strong-password
DB_NAME=flightbrief
